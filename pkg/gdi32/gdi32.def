; Minimal gdi32 import library for Crinkler 2.0, which crashes on gdi32.lib from Windows 10 SDKs.
; Lists only the GDI functions the intro calls; add new ones here and to gdi32.c, then rebuild
; from a "x86 Native Tools Command Prompt" in this folder:
;   cl /nologo /c /GS- gdi32.c
;   link /nologo /dll /noentry /nodefaultlib /machine:x86 /def:gdi32.def /out:gdi32.dll gdi32.obj
; Keep gdi32.lib, delete the other outputs.
LIBRARY gdi32.dll
EXPORTS
  ChoosePixelFormat
  SetPixelFormat
  SwapBuffers
